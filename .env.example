# 复制本文件为 .env 后填写真实值：
#   copy .env.example .env      (Windows)
# .env 含密钥，切勿提交到版本库。

# ===================== DeepSeek 大模型 =====================
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=你的密钥

# 可选，默认 deepseek-chat
# DEEPSEEK_MODEL=deepseek-chat


# ================== HuggingFace 模型下载源 ==================
# 首次运行会自动下载嵌入模型 BAAI/bge-small-zh-v1.5（约 95MB）。
# 国内直连 huggingface.co 大概率超时或断流，
# 国内用户请取消下面一行的注释，改走镜像加速下载。
HF_ENDPOINT=https://hf-mirror.com


# ================== Rerank 重排序 ==================
# true=向量召回后用 bge-reranker-v2-m3 精排（提升命中率，模型约 1.2GB）；
# false=纯向量检索。设为 false 可对比测试两种效果。
ENABLE_RERANK=true
